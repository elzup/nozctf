{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "out",
    ".next",
    "public",
    "functions/lib",
    "pnpm-lock.yaml",
    "package-lock.json",
    ".firebase",
    "next-env.d.ts"
  ]
}
